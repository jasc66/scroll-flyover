{
  "name": "scroll-flyover",
  "version": "1.5.0",
  "description": "Claude Code skill + Three.js/WebGL engine for cinematic, scroll-driven fly-through landing pages — no AI image/video generation, zero per-build cost.",
  "type": "module",
  "main": "./references/scrub-engine.js",
  "exports": {
    ".": "./references/scrub-engine.js",
    "./references/*": "./references/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "scroll-flyover": "bin/install.js"
  },
  "scripts": {
    "test": "node --test",
    "qa": "node scripts/qa.mjs",
    "serve": "node scripts/serve.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "node --check bin/install.js && node --test && node scripts/check-package.mjs"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "SKILL.md",
    "references"
  ],
  "keywords": [
    "claude-code",
    "claude-skill",
    "threejs",
    "webgl",
    "scrollytelling",
    "3d"
  ],
  "homepage": "https://github.com/jasc66/scroll-flyover#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasc66/scroll-flyover.git"
  },
  "bugs": {
    "url": "https://github.com/jasc66/scroll-flyover/issues"
  },
  "author": "Alonso Salguero C.",
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.152.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.7.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "three": "^0.186.0"
  }
}
